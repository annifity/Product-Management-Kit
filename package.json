{
  "name": "annifity",
  "version": "2.0.0",
  "private": true,
  "description": "Portable AI Product Builder Kit for Claude, Codex, Cursor, Copilot, and shared agents.",
  "scripts": {
    "prepare": "lefthook install",
    "sync": "node tools/run-powershell.js tools/sync-ai-skill-structures.ps1",
    "docs:build": "node tools/run-powershell.js tools/build-docs-site.ps1",
    "guard": "node tools/run-powershell.js tools/check-self-contained.ps1",
    "skill:validate": "node tools/run-powershell.js tools/test-skill-format.ps1",
    "ref:check": "node tools/run-powershell.js tools/check-ref-integrity.ps1",
    "routing:test": "node tools/run-powershell.js tools/test-skill-routing.ps1",
    "sync:check": "node tools/run-powershell.js tools/sync-ai-skill-structures.ps1 -Check",
    "contract:test": "node tools/run-powershell.js tools/test-skill-contracts.ps1",
    "profile:test": "node tools/run-powershell.js tools/test-artifact-profile-resolution.ps1",
    "baseline:test": "node tools/run-powershell.js tools/test-authoritative-baseline.ps1",
    "registry-migration:test": "node tools/run-powershell.js tools/test-artifact-registry-migration.ps1",
    "mutation:test": "node tools/run-powershell.js tools/test-mutation-safety.ps1",
    "design:test": "node tools/run-powershell.js tools/test-design-package.ps1",
    "pm-calculators:test": "node tools/run-powershell.js tools/test-pm-calculators.ps1",
    "pm-quality:test": "node tools/run-powershell.js tools/test-pm-decision-quality.ps1",
    "task-progress:test": "node tools/run-powershell.js tools/test-task-progress-contract.ps1",
    "p0:test": "npm run profile:test && npm run baseline:test && npm run registry-migration:test && npm run mutation:test && npm run phase-gate:test && npm run design:test && npm run pm-calculators:test && npm run pm-quality:test",
    "session-audit:test": "node tools/run-powershell.js tools/test-session-rework-audit.ps1",
    "semantic:test": "node tools/run-powershell.js tools/test-semantic-forward-harness.ps1",
    "semantic:live:test": "node tools/run-powershell.js tools/test-semantic-forward-live.ps1",
    "output-contract:test": "node tools/run-powershell.js tools/test-output-contract-conformance.ps1",
    "drawio:test": "node tools/run-powershell.js tools/test-drawio-validation.ps1",
    "context:test": "node tools/run-powershell.js tools/test-context-consistency-linter.ps1",
    "p1:test": "npm run session-audit:test && npm run semantic:test && npm run semantic:live:test && npm run output-contract:test && npm run drawio:test && npm run context:test",
    "phase-gate:test": "node tools/run-powershell.js tools/test-phase-gate-approval.ps1",
    "ai-eval:test": "node tools/run-powershell.js tools/test-ai-evaluation-verdict.ps1",
    "repo-doctor:test": "node tools/run-powershell.js tools/test-repo-doctor.ps1",
    "dashboard:test": "node tools/run-powershell.js tools/test-first-pass-quality-dashboard.ps1",
    "p2:test": "npm run phase-gate:test && npm run ai-eval:test && npm run repo-doctor:test && npm run dashboard:test",
    "doctor": "node tools/run-powershell.js tools/invoke-repo-doctor.ps1 -RootPath . -ManifestPath tools/repo-root-manifest.json",
    "workspace:init": "node tools/run-powershell.js tools/init-annifity-workspace.ps1",
    "test": "node tools/run-powershell.js tools/test-annifity.ps1",
    "check": "npm run guard && npm run skill:validate && npm run ref:check && npm run routing:test && npm run sync:check && npm run docs:build && npm run contract:test && npm test",
    "precommit": "node tools/run-powershell.js tools/pre-commit-annifity.ps1"
  },
  "devDependencies": {
    "lefthook": "^1.11.0"
  }
}
