{
  "name": "annifity",
  "version": "2.0.0",
  "private": true,
  "description": "Portable AI Product Builder Kit for Claude, Codex, Cursor, Copilot, and shared agents.",
  "scripts": {
    "prepare": "lefthook install",
    "sync": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/sync-ai-skill-structures.ps1",
    "docs:build": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-docs-site.ps1",
    "guard": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/check-self-contained.ps1",
    "skill:validate": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/test-skill-format.ps1",
    "ref:check": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/check-ref-integrity.ps1",
    "routing:test": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/test-skill-routing.ps1",
    "sync:check": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/sync-ai-skill-structures.ps1 -Check",
    "contract:test": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/test-skill-contracts.ps1",
    "profile:test": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/test-artifact-profile-resolution.ps1",
    "baseline:test": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/test-authoritative-baseline.ps1",
    "registry-migration:test": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/test-artifact-registry-migration.ps1",
    "mutation:test": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/test-mutation-safety.ps1",
    "p0:test": "npm run profile:test && npm run baseline:test && npm run registry-migration:test && npm run mutation:test && npm run phase-gate:test",
    "session-audit:test": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/test-session-rework-audit.ps1",
    "semantic:test": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/test-semantic-forward-harness.ps1",
    "output-contract:test": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/test-output-contract-conformance.ps1",
    "drawio:test": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/test-drawio-validation.ps1",
    "context:test": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/test-context-consistency-linter.ps1",
    "p1:test": "npm run session-audit:test && npm run semantic:test && npm run output-contract:test && npm run drawio:test && npm run context:test",
    "phase-gate:test": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/test-phase-gate-approval.ps1",
    "repo-doctor:test": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/test-repo-doctor.ps1",
    "dashboard:test": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/test-first-pass-quality-dashboard.ps1",
    "p2:test": "npm run phase-gate:test && npm run repo-doctor:test && npm run dashboard:test",
    "doctor": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/invoke-repo-doctor.ps1 -RootPath . -ManifestPath tools/repo-root-manifest.json",
    "workspace:init": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/init-annifity-workspace.ps1",
    "test": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/test-annifity.ps1",
    "check": "npm run guard && npm run skill:validate && npm run ref:check && npm run routing:test && npm run sync:check && npm run docs:build && npm run contract:test && npm test",
    "precommit": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/pre-commit-annifity.ps1"
  },
  "devDependencies": {
    "lefthook": "^1.11.0"
  }
}
