{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:annifity:repo-root-manifest:1.0",
  "title": "Annifity repository root manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "allowedRoots",
    "forbiddenPaths",
    "runtimeNamePatterns"
  ],
  "properties": {
    "$schema": {
      "const": "./repo-root-manifest.schema.json"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "allowedRoots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "kind",
          "gitPolicy",
          "required",
          "explanation"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[^/\\\\]+$"
          },
          "kind": {
            "enum": [
              "canonical",
              "generated",
              "integration",
              "runtime",
              "internal"
            ]
          },
          "gitPolicy": {
            "enum": [
              "tracked",
              "ignored",
              "runtime-local",
              "internal"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "forbiddenPaths": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "code",
          "explanation"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[^/\\\\]+(?:/[^/\\\\]+)*$"
          },
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]+$"
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "runtimeNamePatterns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
