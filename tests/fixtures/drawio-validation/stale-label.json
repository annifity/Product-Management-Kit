{
  "schemaVersion": 1,
  "maxDrawioBytes": 1048576,
  "maxDecodedPageBytes": 2097152,
  "artifacts": [
    {
      "path": "workspace/stale-label.drawio",
      "linkedSources": ["workspace/source.md"],
      "minimumRenderablePages": 1,
      "forbiddenLabels": [],
      "staleLabels": [
        {
          "text": "Supervisor Portal",
          "replacement": "GBIA Portal",
          "match": "exact",
          "caseSensitive": false
        }
      ]
    }
  ]
}
